{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["node --loader ts-node/esm", "src/server.ts"],
      "skipFiles": ["<node_internals>/**", "node_modules/**"]
    }
  ]
}
